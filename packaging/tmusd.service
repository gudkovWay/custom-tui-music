[Unit]
Description=tmus — терминальный музыкальный плеер (демон)
Documentation=https://github.com/q/custom-tui-music
# Демон публикует MPRIS и иконку SNI, поэтому ему нужна сессионная шина.
# Оболочка (noctalia) может подняться позже — трей регистрируется с
# повтором, так что жёсткой зависимости от неё здесь нет.
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/tmusd
Restart=on-failure
RestartSec=3

# Демон держит подпроцесс mpv. KillMode=control-group гасит и его:
# иначе mpv остался бы играть без демона, и остановить его было бы нечем.
KillMode=control-group
TimeoutStopSec=10

# Сеть, диск и D-Bus нужны; всё остальное — нет.
NoNewPrivileges=yes
# Приватный /tmp обязателен: ProtectSystem=strict делает общий /tmp
# только для чтения, а cookies браузера читаются через копию базы во
# временном каталоге (живой браузер держит её залоченной). Без этого
# провайдер не поднимался: «временный каталог не создался:
# Read-only file system».
PrivateTmp=yes
ProtectSystem=strict
# ProtectHome принимает только yes|no|read-only|tmpfs. `read-write`
# systemd игнорировал с предупреждением в журнале. Домашний каталог
# нужен на запись (кэш, состояние, чтение cookies), поэтому `no`.
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Кэш и состояние объявляем systemd, а не через ReadWritePaths: тот
# требует, чтобы каталоги УЖЕ существовали, и на чистой системе юнит
# падал с `status=226/NAMESPACE` ещё до запуска демона — а создаёт их
# как раз демон. CacheDirectory/StateDirectory создают их сами и дают
# на запись. В user-юните они разворачиваются в $XDG_CACHE_HOME/tmus и
# $XDG_STATE_HOME/tmus.
CacheDirectory=tmus
StateDirectory=tmus

Environment=TMUS_LOG=info

[Install]
WantedBy=graphical-session.target
