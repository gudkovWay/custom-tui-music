-- Hint identities follow rendered node paths and semantic data, never closures
-- regenerated by draw(), artwork paths or the playback clock.
local Hint = {}
local Instance = {}
Instance.__index = Instance
local ALPHABET = "asdfghjklqwertyuiopzxcvbnm"
-- Source: xkbcli compile-keymap --layout us / --layout ru.
local RU = {
  cyrillic_shorti = "q", cyrillic_tse = "w", cyrillic_u = "e",
  cyrillic_ka = "r", cyrillic_ie = "t", cyrillic_en = "y",
  cyrillic_ghe = "u", cyrillic_sha = "i", cyrillic_shcha = "o",
  cyrillic_ze = "p", cyrillic_ef = "a", cyrillic_yeru = "s",
  cyrillic_ve = "d", cyrillic_a = "f", cyrillic_pe = "g",
  cyrillic_er = "h", cyrillic_o = "j", cyrillic_el = "k",
  cyrillic_de = "l", cyrillic_ya = "z", cyrillic_che = "x",
  cyrillic_es = "c", cyrillic_em = "v", cyrillic_i = "b",
  cyrillic_te = "n", cyrillic_softsign = "m",
}

function Hint.letter(chord)
  local key = string.lower(tostring(chord or ""))
  return RU[key] or (key:match("^[a-z]$") and key or nil)
end

local function part(value)
  local text = tostring(value or "")
  return tostring(#text) .. ":" .. text
end

local function visible(node)
  local p = node.props or {}
  return p.visible ~= false and p.enabled ~= false and p.opacity ~= 0
end

-- Do not steal a nested action's caption for its parent's hint.
local function anchor(node, root)
  if not visible(node) then return nil end
  local p = node.props or {}
  if node ~= root and type(p.onClick) == "function" then return nil end
  if node.type == "label" or node.type == "glyph" then return node end
  for _, child in ipairs(node.children or {}) do
    local found = anchor(child, root)
    if found then return found end
  end
  return nil
end

local function label(index, width)
  local out = ""
  for _ = 1, width do
    local digit = index % #ALPHABET + 1
    out = ALPHABET:sub(digit, digit) .. out
    index = math.floor(index / #ALPHABET)
  end
  return out
end

function Hint.new()
  return setmetatable({ active = false, prefix = "", targets = {}, down = {} }, Instance)
end

function Instance:isActive()
  return self.active
end

function Instance:isStale()
  return self.stale == true
end

function Instance:cancel()
  self.active = false
  self.stale = false
  self.prefix = ""
  self.frozen = nil
  self.fingerprint = nil
end

function Instance:reset()
  self:cancel()
  self.down = {}
end

function Instance:release(chord)
  self.down[string.lower(tostring(chord))] = nil
end

function Instance:isDown(chord)
  return self.down[string.lower(tostring(chord))] == true
end

function Instance:start(chord)
  local key = string.lower(tostring(chord))
  if self.down[key] then return false end
  self.down[key] = true
  self.stale = false

  if #self.targets == 0 then return false end
  local width, capacity = 2, #ALPHABET * #ALPHABET
  while capacity < #self.targets do
    width = width + 1
    capacity = capacity * #ALPHABET
  end
  self.active = true
  self.prefix = ""
  self.fingerprint = self.currentFingerprint
  self.frozen = {}
  for i, target in ipairs(self.targets) do
    self.frozen[i] = { code = label(i - 1, width), action = target.action }
  end
  return true
end

function Instance:press(chord)
  if not self.active then return false end
  local key = string.lower(tostring(chord))
  if self.down[key] then return true end
  self.down[key] = true
  if key == "escape" then
    self:cancel()
  elseif key == "backspace" then
    self.prefix = self.prefix:sub(1, -2)
  else
    local letter = Hint.letter(chord)
    if letter then
      local prefix = self.prefix .. letter
      for _, target in ipairs(self.frozen) do
        if target.code:sub(1, #prefix) == prefix then
          self.prefix = prefix
          if target.code == prefix then
            local action = target.action
            self:cancel()
            action()
          end
          return true
        end
      end
      -- Invalid input does not activate anything or escape to normal bindings.
    end
  end
  return true
end

function Instance:render(tree, accent)
  local targets, pieces = {}, {}
  local footer, mode
  local function visit(node, parent, position, allowed)
    local p = node.props or {}
    local path = parent .. "/" .. part(p.key or position)
    local identity, explicitAnchor = p.hintIdentity, p.hintAnchor
    p.hintIdentity, p.hintAnchor = nil, nil
    allowed = allowed and visible(node)
    if p.key == "footer" then footer = node end
    if p.key == "footer-mode" then mode = node end
    local action = p.onClick
    if allowed and type(action) == "function" then
      local badge = node.type == "button" and node or explicitAnchor or anchor(node, node)
      if badge then
        table.insert(targets, { node = node, badge = badge, action = action })
        local bp = badge.props or {}
        table.insert(pieces, part(path) .. part(identity) .. part(node.type)
          .. part(p.label) .. part(p.glyph) .. part(bp.text or bp.name)
          .. part(p.width) .. part(p.height))
      end
      p.onClick = function(...)
        self:cancel()
        return action(...)
      end
    end
    -- Dragging/text edits are context changes, not hint selections.
    for _, name in ipairs({ "onChange", "onDragEnd" }) do
      local callback = p[name]
      if type(callback) == "function" then
        p[name] = function(...)
          self:cancel()
          return callback(...)
        end
      end
    end
    for i, child in ipairs(node.children or {}) do
      visit(child, path, i, allowed)
    end
  end
  visit(tree, "", 1, true)
  self.currentFingerprint = table.concat(pieces, "")
  self.targets = targets
  if self.active and self.fingerprint ~= self.currentFingerprint then
    self:cancel()
    -- Do not reinterpret the unfinished code as destructive normal bindings.
    self.stale = true
  end
  if self.active then
    for i, target in ipairs(targets) do
      local code = self.frozen[i].code
      if code:sub(1, #self.prefix) == self.prefix then
        local badge = target.badge
        local p = badge.props
        local shown = string.upper(code)
        if badge.type == "button" then
          if p.glyph and (p.text == nil or p.text == "") then
            -- A retained Button keeps removed glyphs and text-tier padding.
            -- Render a separate fixed-size click target while hints are shown.
            badge.type = "row"
            badge.props = {
              key = tostring(p.key) .. "-hint", width = p.width or 32,
              height = p.height or 32, flexGrow = p.flexGrow,
              align = "center", justify = "center",
              fill = p.fill, border = p.border, borderWidth = p.borderWidth,
              radius = p.radius, onClick = p.onClick,
            }
            badge.children = { {
              type = "label",
              props = { key = "hint-code", text = shown, fontSize = 10,
                color = p.color or accent, maxLines = 1 },
            } }
          else
            p.text = shown .. ((p.text and p.text ~= "") and (" · " .. p.text) or "")
          end
        else
          if badge.type == "glyph" then
            badge.type = "label"
            p.name = nil
            p.fontSize = 10
          end
          p.text = shown .. ((p.text and p.text ~= "") and (" · " .. p.text) or "")
          p.color = accent
          p.maxLines = 1
        end
      end
    end
    if footer then footer.props.text = "F → метка · BackSpace — исправить · Esc — отмена" end
    if mode then
      mode.props.text = "HINTS " .. string.upper(self.prefix)
      mode.props.color = accent
    end
  end
  if self.stale then
    if footer then footer.props.text = "Цели изменились · F — новые метки · Esc — отмена" end
    if mode then mode.props.text = "HINTS STALE"; mode.props.color = accent end
  end
  return tree
end

return Hint
